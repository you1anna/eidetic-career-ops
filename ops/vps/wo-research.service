[Unit]
Description=work-ops job and contact research
After=network-online.target
Wants=network-online.target
Requires=wo-research-codex.socket
After=wo-research-codex.socket
ConditionPathExists=/srv/work-ops/data/work-ops.db

[Service]
Type=oneshot
User=workops
Group=workops
UMask=0077
Environment=TZ=Europe/London
Environment=TMPDIR=/srv/work-ops/run
WorkingDirectory=/srv/work-ops/work-ops
ExecStart=/srv/work-ops/venv/bin/python tools/research_worker.py --db /srv/work-ops/data/work-ops.db --data /srv/work-ops/data
TimeoutStartSec=2700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadWritePaths=/srv/work-ops/data /srv/work-ops/run
InaccessiblePaths=/srv/work-ops/.ssh
MemoryMax=512M
