[Unit]
Description=work-ops nightly database backup (local copy and encrypted off-host copy)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/work-ops/data/work-ops.db

[Service]
Type=oneshot
User=workops
Group=workops
Environment=TMPDIR=/srv/work-ops/run
Environment=TZ=Europe/London
Environment=WO_DB=/srv/work-ops/data/work-ops.db
WorkingDirectory=/srv/work-ops/run
ExecStart=/srv/work-ops/work-ops/ops/vps/wo-backup.sh
TimeoutStartSec=300
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Decision #27: the same kernel, namespace and system-call limits as the tunnel.
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
ReadWritePaths=/srv/work-ops/data /srv/work-ops/run /srv/offsite/work-ops
InaccessiblePaths=/srv/work-ops/.ssh
