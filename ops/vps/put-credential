#!/usr/bin/env bash
#
# Store one key for the daily run, encrypted at rest with the host key, readable only by root, and
# decrypted by systemd only into wo-scan.service's credential directory. Reads the value from stdin and
# never prints it. Run as root (sudo); ops/vps/send-credential.sh calls it from the Mac.
#
#   put-credential COMPANIES_HOUSE_API_KEY < value
set -euo pipefail
name=${1:-}
case "$name" in
  COMPANIES_HOUSE_API_KEY|ADZUNA_APP_ID|ADZUNA_APP_KEY|REED_API_KEY|WO_ALERTS_IMAP_HOST|WO_ALERTS_IMAP_USER|WO_ALERTS_IMAP_PASSWORD|WO_EMAIL_BUFFER_TOKEN) ;;
  *) echo "put-credential: unknown credential name '$name'" >&2; exit 2 ;;
esac
[[ $EUID -eq 0 ]] || { echo "put-credential: run as root" >&2; exit 2; }
install -d -m 700 -o root -g root /etc/credstore.encrypted
umask 077
systemd-creds setup >/dev/null 2>&1 || true
value=$(cat)
[[ -n "$value" ]] || { echo "put-credential: empty value on stdin" >&2; exit 2; }
printf '%s' "$value" | systemd-creds encrypt --name="$name" - "/etc/credstore.encrypted/$name"
chmod 600 "/etc/credstore.encrypted/$name"
echo "stored $name (encrypted, $(stat -c %s "/etc/credstore.encrypted/$name") bytes)"
